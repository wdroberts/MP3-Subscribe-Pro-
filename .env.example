# Google Speech-to-Text (service account)
# Option A: path to your service account JSON key file
GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account.json
GOOGLE_PROJECT_ID=your-project-id
# Option B: paste the entire JSON key as a single line (no file needed)
# GOOGLE_CREDENTIALS_JSON={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}

# OpenAI (for summarization)
OPENAI_API_KEY=your-api-key

# Server
PORT=3001
NODE_ENV=development

# File storage
UPLOAD_DIR=./tmp/uploads
MAX_FILE_SIZE_MB=100
